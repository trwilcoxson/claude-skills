{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trwilcoxson/claude-skills/threat-model/evals/result.schema.json",
  "title": "Grader result for one (case, arm)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "arm", "triggered", "rubric_scores", "must_find_hits", "must_find_misses", "metrics"],
  "properties": {
    "case_id": { "type": "string" },
    "arm": { "enum": ["skill", "baseline"], "description": "skill = threat-model loaded; baseline = same prompt, no skill" },
    "triggered": { "type": "boolean", "description": "did the threat-model skill activate / did the run produce a threat model" },
    "rubric_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "justification"],
        "properties": {
          "id": { "type": "string", "description": "matches a rubric id in the case" },
          "verdict": { "enum": ["pass", "partial", "fail"] },
          "justification": { "type": "string", "description": "evidence from the output; quote or cite the section" }
        }
      }
    },
    "must_find_hits": { "type": "array", "items": { "type": "string" }, "description": "MF ids the output surfaced" },
    "must_find_misses": { "type": "array", "items": { "type": "string" }, "description": "MF ids the output missed" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "tokens_in", "tokens_out"],
      "properties": {
        "elapsed_ms": { "type": ["integer", "null"] },
        "tokens_in": { "type": ["integer", "null"] },
        "tokens_out": { "type": ["integer", "null"] }
      }
    },
    "summary": { "type": "string" }
  }
}
